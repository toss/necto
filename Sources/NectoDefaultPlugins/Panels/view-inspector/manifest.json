{
  "schemaVersion": 1,
  "id": "view-inspector",
  "name": "Views",
  "description": "The hierarchy on screen, and where each view sits",
  "version": "0.1.0",
  "author": "Necto",
  "icon": {
    "systemName": "square.3.layers.3d"
  },
  "assets": [
    "index.html",
    "assets"
  ],
  "allowedOrigins": [
    "self"
  ],
  "operations": [
    {
      "id": "views.tree",
      "title": "Snapshot the hierarchy",
      "description": "Every window's view tree, at this moment",
      "kind": "once",
      "binding": {
        "name": "necto.device.views.tree",
        "version": 1
      },
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "windows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "className": {
                  "type": "string"
                },
                "frame": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "text": {
                  "type": "string"
                },
                "isHidden": {
                  "type": "boolean"
                },
                "alpha": {
                  "type": "number"
                },
                "children": {
                  "type": "array"
                }
              },
              "additionalProperties": true,
              "required": [
                "className",
                "frame",
                "children"
              ]
            }
          }
        },
        "additionalProperties": true,
        "required": [
          "windows"
        ]
      },
      "timeoutMs": 5000
    },
    {
      "id": "views.search",
      "title": "Search the hierarchy",
      "description": "Views whose class or text contains the query",
      "kind": "once",
      "binding": { "name": "necto.device.views.search", "version": 1 },
      "inputSchema": {
        "type": "object",
        "properties": { "query": { "type": "string" } },
        "required": ["query"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": { "matches": { "type": "array", "items": { "type": "object" } } },
        "required": ["matches"],
        "additionalProperties": false
      },
      "timeoutMs": 5000
    },
    {
      "id": "views.inspect",
      "title": "Inspect a view",
      "description": "Current details for one view",
      "kind": "once",
      "binding": { "name": "necto.device.views.inspect", "version": 1 },
      "inputSchema": {
        "type": "object",
        "properties": { "viewID": { "type": "string" } },
        "required": ["viewID"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": { "view": { "type": "object" } },
        "required": ["view"],
        "additionalProperties": false
      },
      "timeoutMs": 5000
    },
    {
      "id": "views.snapshot",
      "title": "Save a snapshot",
      "description": "Hierarchy retained for a later comparison",
      "kind": "once",
      "binding": { "name": "necto.device.views.snapshot", "version": 1 },
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "properties": {
          "snapshotID": { "type": "string" },
          "windows": { "type": "array", "items": { "type": "object" } }
        },
        "required": ["snapshotID", "windows"],
        "additionalProperties": false
      },
      "timeoutMs": 5000
    },
    {
      "id": "views.compare",
      "title": "Compare snapshots",
      "description": "Changes from a saved hierarchy to the current hierarchy",
      "kind": "once",
      "binding": { "name": "necto.device.views.compare", "version": 1 },
      "inputSchema": {
        "type": "object",
        "properties": { "baselineSnapshotID": { "type": "string" } },
        "required": ["baselineSnapshotID"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "snapshotID": { "type": "string" },
          "changes": { "type": "array", "items": { "type": "object" } }
        },
        "required": ["snapshotID", "changes"],
        "additionalProperties": false
      },
      "timeoutMs": 5000
    },
    {
      "id": "views.highlight",
      "title": "Highlight a view",
      "description": "Draw a temporary outline over one view",
      "kind": "once",
      "binding": { "name": "necto.device.views.highlight", "version": 1 },
      "inputSchema": {
        "type": "object",
        "properties": { "viewID": { "type": "string" }, "duration": { "type": "number" } },
        "required": ["viewID"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": { "highlighted": { "type": "boolean" } },
        "required": ["highlighted"],
        "additionalProperties": false
      },
      "timeoutMs": 5000
    },
    {
      "id": "views.tap",
      "title": "Activate a view",
      "description": "Send the primary action to one view",
      "kind": "once",
      "binding": { "name": "necto.device.views.tap", "version": 1 },
      "inputSchema": {
        "type": "object",
        "properties": { "viewID": { "type": "string" } },
        "required": ["viewID"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "tapped": { "type": "boolean" },
          "method": { "type": "string", "enum": ["accessibilityActivate", "primaryAction"] }
        },
        "required": ["tapped", "method"],
        "additionalProperties": false
      },
      "timeoutMs": 5000
    },
    {
      "id": "views.tapAt",
      "title": "Activate at a coordinate",
      "description": "Hit-test a screen coordinate and send its public activation action",
      "kind": "once",
      "binding": { "name": "necto.device.views.tapAt", "version": 1 },
      "inputSchema": {
        "type": "object",
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" }
        },
        "required": ["x", "y"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "tapped": { "type": "boolean" },
          "method": { "type": "string", "enum": ["accessibilityActivate", "primaryAction"] },
          "x": { "type": "number" },
          "y": { "type": "number" }
        },
        "required": ["tapped", "method", "x", "y"],
        "additionalProperties": false
      },
      "timeoutMs": 5000
    },
    {
      "id": "views.scroll",
      "title": "Scroll to a view",
      "description": "Move the nearest scroll view around one view",
      "kind": "once",
      "binding": { "name": "necto.device.views.scroll", "version": 1 },
      "inputSchema": {
        "type": "object",
        "properties": {
          "viewID": { "type": "string" },
          "direction": { "type": "string", "enum": ["up", "down", "left", "right"] },
          "amount": { "type": "number" }
        },
        "required": ["viewID", "direction"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": { "offset": { "type": "array", "items": { "type": "number" } } },
        "required": ["offset"],
        "additionalProperties": false
      },
      "timeoutMs": 5000
    },
    {
      "id": "views.swipe",
      "title": "Swipe a scroll view",
      "description": "Move the nearest scroll view in the direction of a finger swipe",
      "kind": "once",
      "binding": { "name": "necto.device.views.swipe", "version": 1 },
      "inputSchema": {
        "type": "object",
        "properties": {
          "viewID": { "type": "string" },
          "direction": { "type": "string", "enum": ["up", "down", "left", "right"] },
          "amount": { "type": "number", "minimum": 0 }
        },
        "required": ["viewID", "direction"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "offset": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "method": { "type": "string", "enum": ["contentOffset"] }
        },
        "required": ["offset", "method"],
        "additionalProperties": false
      },
      "timeoutMs": 5000
    },
    {
      "id": "views.drag",
      "title": "Drag inside a scroll view",
      "description": "Move the scroll view under a start coordinate by the drag delta",
      "kind": "once",
      "binding": { "name": "necto.device.views.drag", "version": 1 },
      "inputSchema": {
        "type": "object",
        "properties": {
          "fromX": { "type": "number" },
          "fromY": { "type": "number" },
          "toX": { "type": "number" },
          "toY": { "type": "number" }
        },
        "required": ["fromX", "fromY", "toX", "toY"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "offset": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "method": { "type": "string", "enum": ["contentOffset"] }
        },
        "required": ["offset", "method"],
        "additionalProperties": false
      },
      "timeoutMs": 5000
    },
    {
      "id": "views.longPress",
      "title": "Hold a control",
      "description": "Hold a UIControl using public touch-down and touch-up control events",
      "kind": "once",
      "binding": { "name": "necto.device.views.longPress", "version": 1 },
      "inputSchema": {
        "type": "object",
        "properties": {
          "viewID": { "type": "string" },
          "duration": { "type": "number", "minimum": 0.1, "maximum": 10 }
        },
        "required": ["viewID"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "pressed": { "type": "boolean" },
          "duration": { "type": "number" },
          "method": { "type": "string", "enum": ["controlEvents"] }
        },
        "required": ["pressed", "duration", "method"],
        "additionalProperties": false
      },
      "timeoutMs": 15000
    },
    {
      "id": "views.inputText",
      "title": "Enter text",
      "description": "Focus a UIKeyInput view and insert text",
      "kind": "once",
      "binding": { "name": "necto.device.views.inputText", "version": 1 },
      "inputSchema": {
        "type": "object",
        "properties": {
          "viewID": { "type": "string" },
          "text": { "type": "string" },
          "replace": { "type": "boolean" }
        },
        "required": ["viewID", "text"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "inserted": { "type": "boolean" },
          "length": { "type": "integer" },
          "method": { "type": "string", "enum": ["UIKeyInput"] }
        },
        "required": ["inserted", "length", "method"],
        "additionalProperties": false
      },
      "timeoutMs": 5000
    }
  ]
}
