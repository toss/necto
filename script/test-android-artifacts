#!/usr/bin/env python3
"""Verify what the Android build ships: the SDK asks for no permissions, carries the
iOS panels unchanged, and the sample is debuggable in debug builds only."""
import argparse
import json
import io
import os
from pathlib import Path
import subprocess
import zipfile

root = Path(__file__).resolve().parent.parent
android = root / "SDK/Android"
sdk = Path(os.environ.get("ANDROID_HOME", Path.home() / "Library/Android/sdk"))
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--aapt", default=str(sdk / "build-tools/35.0.0/aapt"))
args = parser.parse_args()
results = {}

# A plugin owns its panel; the bridge and capture adapters carry no unrelated assets.
plugins = {
    "necto-events-plugin": "event-log",
    "necto-network-plugin": "network-logger",
    "necto-files-plugin": "files",
    "necto-ui-control-plugin": "control",
    "necto-performance-plugin": "performance-monitor",
    "necto-datastore-preferences-plugin": "preferences",
}
android_modules = {"necto-android", "necto-files-plugin", "necto-ui-control-plugin", "necto-process-metric-plugin", "necto-datastore-preferences-plugin"}
modules = ["necto-core", "necto-plugin-support", "necto-android", "necto-okhttp-capture-plugin", "necto-process-metric-plugin", *plugins]
compared = 0
for module in modules:
    if module in android_modules:
        artifact = android / f"{module}/build/outputs/aar/{module}-release.aar"
        with zipfile.ZipFile(artifact) as aar:
            assert "uses-permission" not in aar.read("AndroidManifest.xml").decode(), module
            contents = aar.read("classes.jar")
        archive = zipfile.ZipFile(io.BytesIO(contents))
    else:
        artifact = next(path for path in (android / module / "build/libs").glob(f"{module}-[0-9]*.jar")
                        if not path.name.endswith(("-sources.jar", "-test-fixtures.jar")))
        archive = zipfile.ZipFile(artifact)
    with archive:
        carried = {name.split("/")[2] for name in archive.namelist() if name.startswith("necto/panels/") and name.endswith("manifest.json")}
        expected_id = plugins.get(module)
        assert carried == ({expected_id} if expected_id else set()), (module, carried)
        if module == "necto-core":
            assert not any(name.startswith("im/toss/necto/plugins/") for name in archive.namelist())
        if expected_id:
            panel = next((root / "SDK/iOS/Sources").glob(f"*/Panels/{expected_id}/manifest.json")).parent
            override = android / module / f"src/main/panel-manifests/{expected_id}.json"
            for file in sorted(path for path in panel.rglob("*") if path.is_file()):
                relative = file.relative_to(panel).as_posix()
                expected = override.read_bytes() if relative == "manifest.json" and override.exists() else file.read_bytes()
                assert archive.read(f"necto/panels/{expected_id}/{relative}") == expected, (module, relative)
                compared += 1
    results[module] = dict(bytes=artifact.stat().st_size, panels=sorted(carried))
results["panels"] = dict(files=compared)

# Necto starts in debuggable builds only, so a release must not be debuggable.
for variant, suffix in (("debug", ""), ("release", "-unsigned")):
    apk = android / f"sample/build/outputs/apk/{variant}/sample-{variant}{suffix}.apk"
    badging = subprocess.check_output([args.aapt, "dump", "badging", str(apk)], text=True)
    debuggable = "application-debuggable" in badging.splitlines()
    assert debuggable == (variant == "debug"), f"Unexpected debuggable flag in {variant}"
    results[variant] = dict(debuggable=debuggable)

output = root / "Build/Android/artifact-results.json"
output.parent.mkdir(parents=True, exist_ok=True)
output.write_text(json.dumps(results, indent=2))
print(f"PASS: optional modules carry only their own panels, no SDK permissions, {compared} panel files match, debuggable in debug only")
