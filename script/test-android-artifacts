#!/usr/bin/env python3
"""Verify what the Android build ships: no SDK module asks for a permission, and each
plugin module carries its own panel and nothing else."""
import json
import io
from pathlib import Path
import zipfile

root = Path(__file__).resolve().parent.parent
android = root / "SDK/Android"
results = {}

# A plugin owns its panel; the bridge and capture adapters carry no unrelated assets.
plugins = {
    "necto-events-plugin": "event-log",
    "necto-network-plugin": "network-logger",
    "necto-files-plugin": "files",
    "necto-ui-control-plugin": "control",
    "necto-performance-plugin": "performance-monitor",
    "necto-datastore-preferences-plugin": "preferences",
}
# A plugin module lives in SDK/Plugins/<Name>/Android, beside the panel it packages.
folders = {
    "necto-events-plugin": "Events",
    "necto-network-plugin": "Network",
    "necto-okhttp-capture-plugin": "OkHttpCapture",
    "necto-files-plugin": "Files",
    "necto-performance-plugin": "Performance",
    "necto-process-metric-plugin": "ProcessMetric",
    "necto-ui-control-plugin": "UIControl",
    "necto-datastore-preferences-plugin": "Preferences",
}


def directory(module):
    return root / "SDK/Plugins" / folders[module] / "Android" if module in folders else android / module


android_modules = {"necto-android", "necto-files-plugin", "necto-ui-control-plugin", "necto-process-metric-plugin", "necto-datastore-preferences-plugin"}
modules = ["necto-core", "necto-plugin-support", "necto-android", "necto-okhttp-capture-plugin", "necto-process-metric-plugin", *plugins]
for module in modules:
    if module in android_modules:
        artifact = directory(module) / f"build/outputs/aar/{module}-release.aar"
        with zipfile.ZipFile(artifact) as aar:
            assert "uses-permission" not in aar.read("AndroidManifest.xml").decode(), module
            contents = aar.read("classes.jar")
        archive = zipfile.ZipFile(io.BytesIO(contents))
    else:
        artifact = next(path for path in (directory(module) / "build/libs").glob(f"{module}-[0-9]*.jar")
                        if not path.name.endswith(("-sources.jar", "-test-fixtures.jar")))
        archive = zipfile.ZipFile(artifact)
    with archive:
        carried = {name.split("/")[2] for name in archive.namelist() if name.startswith("necto/panels/") and name.endswith("manifest.json")}
        expected_id = plugins.get(module)
        assert carried == ({expected_id} if expected_id else set()), (module, carried)
        if module == "necto-core":
            assert not any(name.startswith("im/toss/necto/plugins/") for name in archive.namelist())
    results[module] = dict(bytes=artifact.stat().st_size, panels=sorted(carried))

output = root / "Build/Android/artifact-results.json"
output.parent.mkdir(parents=True, exist_ok=True)
output.write_text(json.dumps(results, indent=2))
print("PASS: no SDK module declares a permission, and each plugin module carries only its own panel")
