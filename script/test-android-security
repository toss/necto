#!/usr/bin/env python3
"""Exercise malformed clients against the running local Android sample only."""
import json
import os
from pathlib import Path
import signal
import socket
import struct
import subprocess
import time

root = Path(__file__).resolve().parent.parent
out = root / "Build/AndroidPOC"
run = json.loads((out / "current-run.json").read_text())
assert run["applicationID"] == "dev.necto.sample"
results = {}


def adb(*args):
    return subprocess.run([run["adb"], "-s", run["serial"], *args],
                          capture_output=True, check=True, timeout=10).stdout


def read_exact(client, count):
    value = b""
    while len(value) < count:
        part = client.recv(count - len(value))
        if not part:
            raise EOFError()
        value += part
    return value


def receive(client):
    size, = struct.unpack(">I", read_exact(client, 4))
    assert 0 < size <= 32 * 1024 * 1024
    return json.loads(read_exact(client, size))


def send(client, value):
    value = json.dumps(value).encode()
    client.sendall(struct.pack(">I", len(value)) + value)


def connect(handshake=True):
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        client = socket.socket(socket.AF_UNIX)
        client.settimeout(12)
        try:
            client.connect(run["socketPath"])
            assert receive(client)["appBundleID"] == "dev.necto.sample"
            if handshake:
                send(client, {"accepted": True, "hostProtocolVersion": 1})
                assert receive(client)["type"] == "plugin.register"
            return client
        except (OSError, EOFError):
            client.close()
            time.sleep(0.1)
    raise AssertionError("Sample did not accept a private connection")


def closed(client):
    while True:
        try:
            if not client.recv(65536):
                return
        except ConnectionResetError:
            return


def invoke(client, request_id, operation, kind="once"):
    send(client, {"type": "plugin.invoke", "payload": {
        "requestID": request_id, "name": "necto.device." + operation,
        "version": 1, "kind": kind, "input": {},
    }})


expected_host = root / "Build/AndroidPOC/Products/Debug/Necto.app/Contents/MacOS/Necto"
command = subprocess.check_output(["ps", "-p", str(run["pid"]), "-o", "command="], text=True).strip()
assert command == str(expected_host), "The recorded POC host is no longer running"
def terminate(signum, _frame):
    raise SystemExit(128 + signum)


signal.signal(signal.SIGTERM, terminate)
os.kill(run["pid"], signal.SIGSTOP)
try:
    adb("shell", "am", "force-stop", "dev.necto.sample")
    adb("shell", "am", "start", "-W", "-n", "dev.necto.sample/.MainActivity")
    with connect(handshake=False) as client:
        start = time.monotonic()
        closed(client)
        assert 3 < time.monotonic() - start < 8
        results["handshakeDeadline"] = True

    for size in (0, 65537, 0xFFFFFFFF):
        with connect() as client:
            client.sendall(struct.pack(">I", size))
            closed(client)
    results["frameLimits"] = True

    with connect() as client:
        nested = ('{"input":' + '[' * 65 + '0' + ']' * 65 + '}').encode()
        client.sendall(struct.pack(">I", len(nested)) + nested)
        closed(client)
        results["nestingLimit"] = True

    with connect() as client:
        start = time.monotonic()
        client.sendall(b"\x00")
        closed(client)
        assert 8 < time.monotonic() - start < 12
        results["partialFrameDeadline"] = True

    with connect() as client:
        for number in range(33):
            try:
                invoke(client, str(number), "events.observe", "stream")
            except BrokenPipeError:
                break
        closed(client)
        results["concurrentRequestLimit"] = True

    with connect() as client:
        invoke(client, "recovered", "events.list")
        reply = receive(client)
        assert reply["payload"]["requestID"] == "recovered"
        assert "events" in reply["payload"]["output"]
        results["recoversWithoutAppRestart"] = True
finally:
    os.kill(run["pid"], signal.SIGCONT)

(out / "security-results.json").write_text(json.dumps(results, indent=2))
print("PASS: " + ", ".join(results))
