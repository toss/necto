#!/usr/bin/env bash
#
# Run unit tests and release artifact contract tests.
#
# Usage:
#   script/test          run everything
#   script/test swift    Swift packages only
#   script/test web      web packages only
#   script/test release  release artifact contracts, without building or publishing
#   script/test native   native panel cache and shell approval checks, without opening the app
#   script/test layout   browser layout smoke tests only
set -euo pipefail
cd "$(dirname "$0")/.."

scope="${1:-all}"
failed=()

run() {
  local name="$1"
  shift
  echo "==> ${name}"
  if "$@"; then
    echo "    ok"
  else
    echo "    FAILED"
    failed+=("${name}")
  fi
  echo
}

if [[ "${scope}" == "all" || "${scope}" == "release" ]]; then
  run "release artifact contracts" node --test script/tests/release.test.mjs script/tests/licenses.test.mjs
fi

if [[ "${scope}" == "all" || "${scope}" == "swift" ]]; then
  run "swift test" swift test
  run "Mac swift test" swift test --package-path NectoMac
  run "SDK consumer test" swift test --package-path Tests/Fixtures/SDKConsumer
fi

if [[ "${scope}" == "all" || "${scope}" == "native" ]]; then
  run "native panel cache" node script/check-device-plugin-store.mjs
  run "web content recovery" node script/check-web-content-recovery.mjs
  run "Mac app unit tests" xcodebuild -project Necto.xcodeproj -scheme NectoAppTests \
    -destination 'platform=macOS' -derivedDataPath Build/Tests test
fi

if [[ "${scope}" == "all" || "${scope}" == "web" ]]; then
  if [[ ! -d node_modules ]]; then
    echo "==> yarn install"
    yarn install --immutable
    echo
  fi
  run "web typecheck" yarn typecheck
  run "web test" yarn test
  run "plugin localization harness" node script/check-plugin-localization.mjs
  run "design token harness" node script/check-design-tokens.mjs
  run "design gallery harness" node script/check-design-gallery.mjs
  run "panel asset harness" node script/check-panel-assets.mjs
fi

if [[ "${scope}" == "layout" ]]; then
  if [[ ! -d node_modules ]]; then
    echo "==> yarn install"
    yarn install --immutable
    echo
  fi
  run "plugin layout harness" node script/check-plugin-layout.mjs
fi

if [[ ${#failed[@]} -gt 0 ]]; then
  echo "failed: ${failed[*]}"
  exit 1
fi

echo "all tests passed"
