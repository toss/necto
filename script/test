#!/usr/bin/env bash
#
# Run unit tests and release artifact contract tests.
#
# Usage:
#   script/test          run everything
#   script/test swift    Swift packages only
#   script/test web      web packages only
#   script/test release  package and release contracts, without building or publishing
#   script/test native   Mac app unit and WebView integration tests
set -euo pipefail
cd "$(dirname "$0")/.."

scope="${1:-all}"
case "${scope}" in
  all|swift|web|release|native) ;;
  *) echo "Usage: script/test [swift|web|release|native]" >&2; exit 2 ;;
esac
failed=()

run() {
  local name="$1"
  shift
  echo "==> ${name}"
  if "$@"; then
    echo "    ok"
  else
    echo "    FAILED"
    failed+=("${name}")
  fi
  echo
}

if [[ "${scope}" == "all" || "${scope}" == "release" ]]; then
  run "package and release contracts" node --test script/tests/package.test.mjs script/tests/release.test.mjs
fi

if [[ "${scope}" == "all" || "${scope}" == "swift" ]]; then
  run "swift test" swift test
  run "Mac swift test" swift test --package-path NectoMac
  run "SDK consumer test" swift test --package-path Tests/Fixtures/SDKConsumer
fi

if [[ "${scope}" == "all" || "${scope}" == "native" ]]; then
  run "Mac app unit and integration tests" xcodebuild -project Necto.xcodeproj -scheme NectoAppTests \
    -destination 'platform=macOS' -derivedDataPath Build/Tests test
fi

if [[ "${scope}" == "all" || "${scope}" == "web" ]]; then
  if [[ ! -d node_modules ]]; then
    echo "==> yarn install"
    yarn install --immutable
    echo
  fi
  run "web typecheck" yarn typecheck
  run "web test" yarn test
  run "panel asset harness" node script/check-panel-assets.mjs
fi

if [[ ${#failed[@]} -gt 0 ]]; then
  echo "failed: ${failed[*]}"
  exit 1
fi

echo "all tests passed"
