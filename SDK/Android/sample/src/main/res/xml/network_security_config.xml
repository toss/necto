<?xml version="1.0" encoding="utf-8"?>
<!-- The Network tab talks plain HTTP to LocalApi on loopback. Everything else keeps the
     platform default, so the one request that leaves the app still goes over TLS. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
