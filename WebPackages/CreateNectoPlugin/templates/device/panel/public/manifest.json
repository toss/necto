{
  "schemaVersion": 1,
  "id": "__PLUGIN_ID__",
  "name": "__DISPLAY_NAME__",
  "description": "A device plugin created with create-necto-plugin",
  "version": "0.1.0",
  "author": "Your Name",
  "icon": {
    "systemName": "puzzlepiece.extension"
  },
  "assets": [
    "index.html",
    "assets"
  ],
  "allowedOrigins": [
    "self"
  ],
  "operations": [
    {
      "id": "message.get",
      "title": "Message",
      "description": "Reads a message from the connected app",
      "kind": "once",
      "binding": {
        "name": "necto.device.message.get",
        "version": 1
      },
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "timeoutMs": 3000
    }
  ]
}
