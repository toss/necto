{
  "name": "necto-web",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Necto web plugin library and built-in plugins",
  "workspaces": [
    "WebPackages/Bridge",
    "WebPackages/BuiltInPlugins/src/*",
    "WebPackages/CreateNectoPlugin"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --all --topological run build",
    "typecheck": "yarn workspaces foreach --all run typecheck",
    "test": "yarn workspaces foreach --all run test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "vitepress": "^1.6.3"
  },
  "resolutions": {
    "vitepress/vite": "6.4.3",
    "tsup/esbuild": "0.28.2"
  },
  "packageManager": "yarn@4.6.0"
}
